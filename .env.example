# Copiá este archivo a ".env" para desarrollo local (Vercel CLI: `vercel dev`),
# o cargá estas variables en el panel de Environment Variables de Vercel/Netlify
# para producción. NUNCA subas un archivo ".env" real al repositorio (ya está
# en .gitignore).

# API key de Anthropic (Consola de Anthropic -> console.anthropic.com -> API Keys).
# Esto NO es tu suscripción de claude.ai (Pro/Max) -- es una API separada, facturada
# por uso, necesaria para que /api/chat.js pueda llamar a Claude.
ANTHROPIC_API_KEY=

# Opcional. Modelo a usar. Por defecto: claude-sonnet-5.
# Alternativa más económica: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional. Tope de búsquedas web (tool "web_search") que Claude puede hacer POR MENSAJE
# del usuario. Cada búsqueda cuesta aparte (~USD 10 cada 1000, ver console.anthropic.com).
# Por defecto: 3.
ANTHROPIC_MAX_WEB_SEARCHES=3
